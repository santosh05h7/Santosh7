import { useState, useEffect } from 'react';

export default function App() {
  const [donors, setDonors] = useState([]);
  const [form, setForm] = useState({ name: '', bloodGroup: '', contact: '', city: '' });
  const [copiedId, setCopiedId] = useState(null);
  const API = 'http://localhost:5000/api/donors';

  const loadDonors = async () => {
    const res = await fetch(API);
    setDonors(await res.json());
  };

  useEffect(() => { loadDonors(); }, []);

  const addDonor = async (e) => {
    e.preventDefault();
    await fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(form)
    });
    setForm({ name: '', bloodGroup: '', contact: '', city: '' });
    loadDonors();
  };

  const deleteDonor = async (id) => {
    await fetch(`${API}/${id}`, { method: 'DELETE' });
    loadDonors();
  };

  const copyDonor = (d) => {
    navigator.clipboard.writeText(`${d.name} (${d.bloodGroup}) - ${d.city} | ${d.contact}`);
    setCopiedId(d._id);
    setTimeout(() => setCopiedId(null), 1500);
  };

  return (
    <div style={{ maxWidth: '500px', margin: '30px auto', fontFamily: 'sans-serif' }}>
      <h2>Blood Bank Donor Share</h2>
      <form onSubmit={addDonor} style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
        <input placeholder="Donor Name" required value={form.name} onChange={e => setForm({ ...form, name: e.target.value })} />
        <input placeholder="Blood Group (e.g. O+)" required value={form.bloodGroup} onChange={e => setForm({ ...form, bloodGroup: e.target.value })} />
        <input placeholder="Phone / Contact" required value={form.contact} onChange={e => setForm({ ...form, contact: e.target.value })} />
        <input placeholder="City / Hospital" required value={form.city} onChange={e => setForm({ ...form, city: e.target.value })} />
        <button type="submit" style={{ background: '#c62828', color: '#fff', padding: '8px', border: 'none' }}>Register Donor</button>
      </form>

      <div style={{ marginTop: '20px' }}>
        {donors.map(d => (
          <div key={d._id} style={{ border: '1px solid #ccc', padding: '10px', marginBottom: '8px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <div>
              <strong>{d.name} ({d.bloodGroup})</strong>
              <div>{d.city} | 📞 {d.contact}</div>
            </div>
            <div style={{ display: 'flex', gap: '6px' }}>
              <button onClick={() => copyDonor(d)}>{copiedId === d._id ? 'Copied!' : 'Copy'}</button>
              <button onClick={() => deleteDonor(d._id)}>Remove</button>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}
